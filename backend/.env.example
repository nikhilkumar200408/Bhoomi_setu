# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=bhoomitrust_db

# JWT - replace before any non-demo deployment
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_HASH_SCHEME=bcrypt

# Existing provider defaults (no cloud inference is used by Document AI)
LLM_PROVIDER=demo
LLM_API_KEY=
OCR_PROVIDER=tesseract
EXTRACTION_PROVIDER=regex
TRANSLATE_ENABLED=true

# Local Document AI inference through Ollama (disabled until explicitly enabled)
# Install Ollama and pull the models before setting OLLAMA_ENABLED=true.
# For backend in Docker on macOS, use http://host.docker.internal:11434.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDINGS_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096

# App
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_MB=20

# Notifications are disabled by default. Supply credentials only in an
# untracked backend/.env file or deployment secret manager.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
SMS_PROVIDER=none
NOTIFY_PHONE_NUMBER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# Optional public webpage ingestion: comma-separated exact hostnames only.
# Example: WEB_IMPORT_ALLOWED_DOMAINS=www.example.com,example.org
WEB_IMPORT_ALLOWED_DOMAINS=
