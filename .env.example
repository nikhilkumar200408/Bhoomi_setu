# Root-level environment used by docker-compose.
# Copy to .env for local overrides. Never commit real credentials.

JWT_SECRET=change-this-secret-in-production
PASSWORD_HASH_SCHEME=bcrypt

# Existing deterministic/demo provider defaults
LLM_PROVIDER=demo
LLM_API_KEY=
OCR_PROVIDER=tesseract
EXTRACTION_PROVIDER=regex
TRANSLATE_ENABLED=true

# Local Document AI inference (opt-in; no external API key)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDINGS_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096

NOTIFICATIONS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEMO_MODE=true
